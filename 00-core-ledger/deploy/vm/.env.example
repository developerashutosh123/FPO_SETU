# Template for 00-core-ledger/gateway/.env on the VM (x86_64 Azure or ARM64 Oracle):   cp deploy/vm/.env.example gateway/.env && chmod 600 gateway/.env
# gateway/.env is gitignored. Never commit it, never paste it into a chat. Plain KEY=value lines: no `export`, no spaces around `=`,
# and NO trailing "# comment" on a value line (systemd reads this file too and would keep the comment as part of the value).
#
# Reuse the values from your existing (WSL) gateway/.env for: DATABASE_URL, DIRECT_URL, JWT_SECRET, FARMER_TOKEN_SECRET, PRICE_SALT_SECRET,
# DATAGOVIN_API_KEY and CORS_ORIGINS. JWT_SECRET MUST stay identical to the one in the Vercel read-api project, or tokens stop validating.

# --- required ------------------------------------------------------------------------------------------------------------------------
# Supabase (Mumbai). DATABASE_URL = the pooled (transaction, port 6543) connection string; DIRECT_URL = the direct one, used by migrations.
DATABASE_URL=
DIRECT_URL=
# Each at least 32 characters. Generate NEW ones with: openssl rand -hex 32
JWT_SECRET=
FARMER_TOKEN_SECRET=
PRICE_SALT_SECRET=
# ngrok: your authtoken (dashboard.ngrok.com, Your Authtoken) and the reserved static domain, without https://
NGROK_AUTHTOKEN=
NGROK_DOMAIN=repaying-chant-consumer.ngrok-free.dev
# Exact portal origins (no trailing slash). The wildcard covers the six fposetu-*.vercel.app projects and their previews; the second entry is the tunnel itself.
CORS_ORIGINS=http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3004,http://localhost:3005,http://localhost:3006,https://fposetu-*.vercel.app,https://repaying-chant-consumer.ngrok-free.dev

# --- optional (defaults shown) -------------------------------------------------------------------------------------------------------
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info
DB_POOL_MAX=10
# Real AGMARKNET prices (data.gov.in). Without it the gateway still runs; the seed needs price_series rows already in the database.
DATAGOVIN_API_KEY=
DEMO_PASSWORD=Setu@2026
DEMO_OTP=123456
# Public URLs of the six portals, returned by GET /config/public (set to the real Vercel domains)
URL_FARMER_WEB=https://fposetu-farmer.vercel.app
URL_FPO=https://fposetu-fpo.vercel.app
URL_BANK=https://fposetu-bank.vercel.app
URL_BUYER=https://fposetu-buyer.vercel.app
URL_CONSUMER=https://fposetu-consumer.vercel.app
URL_GOV=https://fposetu-gov.vercel.app
READ_API_URL=https://read-api-ten.vercel.app
# Leave these two as they are (relative to the gateway/ folder)
NETWORK_DIR=../network
WALLET_DIR=../wallet
