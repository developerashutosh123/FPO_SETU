# Set these in the Vercel project (Settings -> Environment Variables), for Production AND Preview. Never commit real values.

# REQUIRED. The same Supabase pooled (transaction, port 6543) connection string the gateway uses (Supabase: Connect, Transaction pooler).
DATABASE_URL=
# Supabase direct connection string (port 5432). Not read at run time: the read-only API never migrates. Setting it is harmless.
DIRECT_URL=
# REQUIRED. The same value as the gateway's JWT_SECRET, so a token issued by the gateway is accepted here.
JWT_SECRET=

# REQUIRED IN PRACTICE: without it only the localhost portals pass CORS and every Vercel portal is blocked by the browser.
# Comma separated; same list as the gateway. A * stands for one host label, for preview deployments, e.g. https://fpo-console-*-myteam.vercel.app
CORS_ORIGINS=https://farmer.example.vercel.app,https://fpo-console.example.vercel.app

# optional: returned by GET /config/public
URL_FARMER_WEB=
URL_FPO=
URL_BANK=
URL_BUYER=
URL_CONSUMER=
URL_GOV=
# optional: Postgres connections per warm function instance (default 3)
DB_POOL_MAX=3
