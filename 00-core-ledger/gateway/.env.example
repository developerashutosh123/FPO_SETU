# FPO-SETU gateway. Copy to .env and fill in. Never commit .env. Never paste keys into a chat.
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info

# Postgres: Supabase (Mumbai). DATABASE_URL is the pooled (transaction) connection, DIRECT_URL the direct one used by migrations.
DATABASE_URL=
DIRECT_URL=

DB_POOL_MAX=10

# Secrets: generate each with `openssl rand -hex 32`
JWT_SECRET=
FARMER_TOKEN_SECRET=
PRICE_SALT_SECRET=

# CORS allowlist, comma separated: the six Vercel domains plus localhost
CORS_ORIGINS=http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3004,http://localhost:3005,http://localhost:3006

# Fabric: where the network material lives (default: ../network and ../wallet)
NETWORK_DIR=../network
WALLET_DIR=../wallet

# data.gov.in key for the real AGMARKNET adapter (Current Daily Price of Various Commodities from Various Markets (Mandi))
DATAGOVIN_API_KEY=

# Demo logins (CONTRACT.md Section 5)
DEMO_PASSWORD=Setu@2026
DEMO_OTP=123456

# Public URLs of the six portals, returned by GET /config/public
URL_FARMER_WEB=http://localhost:3001
URL_FPO=http://localhost:3002
URL_BANK=http://localhost:3003
URL_BUYER=http://localhost:3004
URL_CONSUMER=http://localhost:3005
URL_GOV=http://localhost:3006
READ_API_URL=
