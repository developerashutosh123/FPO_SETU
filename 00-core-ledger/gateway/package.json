{
  "name": "fpo-setu-gateway",
  "version": "1.0.0",
  "private": true,
  "description": "FPO-SETU gateway API, event indexer and simulated adapters (Fastify, Fabric Gateway, Drizzle)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "sync:contract": "node scripts/sync-contract.mjs",
    "predev": "node scripts/sync-contract.mjs",
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "tsx --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "seed": "tsx --env-file-if-exists=.env scripts/seed-ledger.ts",
    "e2e": "tsx --env-file-if-exists=.env scripts/e2e-journey.ts",
    "load:csv": "tsx --env-file-if-exists=.env scripts/load-agmarknet-csv.ts",
    "check": "pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "@grpc/grpc-js": "^1.14.6",
    "@hyperledger/fabric-gateway": "^1.13.0",
    "@hyperledger/fabric-protos": "^0.2.2",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "jose": "^6.2.12",
    "pdf-lib": "^1.17.1",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "yaml": "^2.9.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^3.2.7"
  }
}
