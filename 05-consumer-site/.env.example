# Local development against the mock gateway (node ../shared/mock/server.mjs, port 4010)
NEXT_PUBLIC_DATA_SOURCE=mock
# NEXT_PUBLIC_MOCK_URL=http://localhost:4010

# Production (Vercel project env vars; values are in 00-core-ledger/docs/RUNBOOK.md section 0)
# NEXT_PUBLIC_DATA_SOURCE=live
# NEXT_PUBLIC_API_URL=https://<NGROK_DOMAIN>
# NEXT_PUBLIC_READ_API_URL=https://<read-api project>.vercel.app

# Outbound link target for proofs (Ledger Explorer in 06)
NEXT_PUBLIC_URL_GOV=http://localhost:3006
