{
  "name": "fposetu-farmer-app",
  "version": "0.1.0",
  "private": true,
  "description": "FPO-SETU farmer app (Expo, web build). Bengali first.",
  "main": "expo-router/entry",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "sync-contract": "node scripts/sync-contract.mjs",
    "predev": "node scripts/sync-contract.mjs",
    "dev": "EXPO_PUBLIC_DATA_SOURCE=mock expo start --web --port 3001",
    "mock": "node ../shared/mock/server.mjs",
    "prebuild": "node scripts/sync-contract.mjs",
    "build": "node scripts/check-build-env.mjs && expo export -p web",
    "build:mock": "EXPO_PUBLIC_DATA_SOURCE=mock expo export -p web",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "check": "pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.0",
    "expo": "~58.0.23",
    "expo-constants": "~58.0.0",
    "expo-linking": "~58.0.16",
    "expo-router": "~58.0.30",
    "expo-speech": "~58.0.3",
    "expo-status-bar": "~58.0.4",
    "i18next": "^26.7.1",
    "lucide-react-native": "^1.68.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "^17.1.12",
    "react-native": "0.88.1",
    "react-native-qrcode-svg": "^6.3.54",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "~15.16.0",
    "react-native-web": "~0.21.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@12.11.2"
}
