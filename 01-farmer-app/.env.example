# Copy to .env.local for local work. In Vercel set the same names (Production and Preview); EXPO_PUBLIC_* values are baked in at build time, so redeploy after changing them.
# Local development against the mock gateway (node ../shared/mock/server.mjs): `pnpm dev` already sets EXPO_PUBLIC_DATA_SOURCE=mock.
EXPO_PUBLIC_DATA_SOURCE=live
# RUNBOOK section 0
EXPO_PUBLIC_API_URL=https://repaying-chant-consumer.ngrok-free.dev
EXPO_PUBLIC_READ_API_URL=https://read-api-ten.vercel.app
# Optional: the env wins over GET /config/public
EXPO_PUBLIC_URL_FARMER_WEB=https://fposetu-farmer.vercel.app
EXPO_PUBLIC_URL_FPO=https://fposetu-fpo.vercel.app
EXPO_PUBLIC_URL_BANK=https://fposetu-bank.vercel.app
EXPO_PUBLIC_URL_BUYER=https://fposetu-buyer.vercel.app
EXPO_PUBLIC_URL_CONSUMER=https://fposetu-consumer.vercel.app
EXPO_PUBLIC_URL_GOV=https://fposetu-gov.vercel.app
