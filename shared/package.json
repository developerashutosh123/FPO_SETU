{
  "name": "fpo-setu-shared",
  "private": true,
  "version": "1.0.2",
  "description": "Contract tooling only (typecheck, tests, fixtures validation, OpenAPI build). Portals copy contract.ts, they never depend on this package.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types test/*.test.ts",
    "gen:fixtures": "node --experimental-strip-types scripts/gen-fixtures.ts",
    "build:openapi": "node --experimental-strip-types scripts/build-openapi.ts",
    "mock": "node mock/server.mjs",
    "check": "pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@types/node": "^22.20.5",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "ts-json-schema-generator": "^2.9.0",
    "typescript": "~5.9.3",
    "yaml": "^2.9.1"
  }
}
