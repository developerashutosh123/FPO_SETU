# Local development against the mock gateway (node ../shared/mock/server.mjs, port 4010)
NEXT_PUBLIC_DATA_SOURCE=mock
# NEXT_PUBLIC_MOCK_URL=http://localhost:4010
# Shows the "Try accepting as the FPO (should fail)" button on /receive and the demo bar
NEXT_PUBLIC_DEMO_MODE=true

# Production (Vercel project env vars; values are in 00-core-ledger/docs/RUNBOOK.md section 0)
# NEXT_PUBLIC_DATA_SOURCE=live
# NEXT_PUBLIC_API_URL=https://<NGROK_DOMAIN>
# NEXT_PUBLIC_READ_API_URL=https://<read-api project>.vercel.app

# Other portals, used only for outbound links (tx IDs -> Gov explorer, lots -> consumer page, orders -> FPO console)
# NEXT_PUBLIC_URL_FPO=https://fposetu-fpo.vercel.app
# NEXT_PUBLIC_URL_CONSUMER=https://fposetu-consumer.vercel.app
# NEXT_PUBLIC_URL_GOV=https://fposetu-gov.vercel.app
